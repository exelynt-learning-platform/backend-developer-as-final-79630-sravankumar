              "raw": "{\n  \"name\": \"Auditorium Omega\",\n  \"description\": \"Large conference auditorium with sound system\",\n  \"resourceType\": \"ROOM\",\n  \"location\": \"Convention Center, Floor 1\",\n  \"capacity\": 100,\n  \"pricePerHour\": 5000.00,\n  \"available\": true\n}"
